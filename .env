# ==========================================
# 本地 Ollama 配置
# ==========================================
# 1. 必填强校验项：由于是本地 Ollama，填任意占位字符串即可（例如 ollama）
ANTHROPIC_API_KEY=ollama

# 2. Ollama 服务地址：指向本地默认端口 11434
ANTHROPIC_BASE_URL=http://localhost:11434

# 3. 指定 Ollama 中已下载的模型名称（根据你本地拉取的模型填写）
ANTHROPIC_MODEL=qwen2.5-coder:7b 

# ==========================================
# 2. Redis 配置（适配你在普通用户目录下启动的无密 Redis）
# ==========================================
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PASSWORD=

# ==========================================
# 3. ChromaDB 向量数据库（本地降级目录）
# ==========================================
CHROMA_PERSIST_DIRECTORY=./data/chroma

# ==========================================
# 4. Skills 与监控配置（系统已有默认值，可直接保留）
# ==========================================
ECHOMIND_SKILLS_DIR=./skills
ECHOMIND_SKILLS_MAX_PROMPT_CHARS=5000
MONITOR_INTERVAL=10
PROMETHEUS_PORT=9091